{
  "name": "Vena HUD",
  "color": {
    "bg":            { "value": "#04070b", "note": "fundal ecran" },
    "surface":       { "value": "rgba(7,17,25,0.88)", "note": "carduri, peste pattern" },
    "surfaceSolid":  { "value": "#071119" },
    "cameraBg":      { "value": "#0a1820" },
    "border":        { "value": "#12303d", "note": "carduri, separatoare" },
    "borderStrong":  { "value": "#1f4a5c", "note": "input, butoane OFF, inel exterior" },
    "text":          { "value": "#cdeefc" },
    "textSecondary": { "value": "#9cc3d3" },
    "textMuted":     { "value": "#7ea9bb", "note": "label-uri mono, min 4.5:1 pe bg" },
    "accent":        { "value": "#4fd8ff", "note": "cyan: ON, inele orb, stare activă" },
    "accentOn":      { "value": "#04070b", "note": "text pe accent" },
    "orbCoreLight":  { "value": "#bff3ff" },
    "orbCenter":     { "value": "#e9fbff" },
    "warning":       { "value": "#e8b25a", "note": "aparate protejate, confirmări" },
    "warningOn":     { "value": "#1a1306" },
    "warningMuted":  { "value": "#a99677" },
    "danger":        { "value": "#ff8a8a", "note": "offline, erori" },
    "rec":           { "value": "#ff6b6b" },
    "offline":       { "value": "#3a4a52" }
  },
  "font": {
    "display": "'Chakra Petch', sans-serif  (400/500/600)",
    "mono":    "'JetBrains Mono', monospace (400/500)",
    "google":  "https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap",
    "note":    "în add-on fonturile se împachetează local (fără CDN), ca să meargă și fără internet"
  },
  "type": {
    "brand":       { "size": 20, "weight": 600, "letterSpacing": "0.32em", "family": "display", "transform": "uppercase" },
    "greeting":    { "size": 26, "weight": 500, "family": "display" },
    "roomTitle":   { "size": 18, "weight": 600, "family": "display" },
    "body":        { "size": 14, "weight": 400, "family": "display" },
    "summary":     { "size": 15, "weight": 400, "family": "display", "color": "textSecondary" },
    "sectionLabel":{ "size": 12, "weight": 500, "letterSpacing": "0.24em", "family": "display", "color": "textMuted", "transform": "uppercase" },
    "stateLabel":  { "size": 12, "letterSpacing": "0.2em", "family": "mono", "transform": "uppercase" },
    "meta":        { "size": 11, "family": "mono" }
  },
  "space": { "pagePadX": 32, "pagePadY": 24, "columnGap": 24, "cardPad": "14px 16px", "cardGap": 12, "stackGap": 10 },
  "radius": { "all": 0, "note": "HUD: colțuri drepte peste tot" },
  "layout": {
    "grid": "minmax(260px,1fr) minmax(380px,1.4fr) minmax(300px,1.1fr)",
    "columns": ["camere + prezență", "orb + conversație", "camera curții + poartă/boxe + jurnal"],
    "target": "laptop 1440x900; sub 1100px coloanele se stivuiesc"
  },
  "control": {
    "toggle":  { "minHeight": 32, "minWidth": 52, "on": "bg accent, text accentOn", "off": "transparent, border borderStrong, text textMuted", "font": "mono 12" },
    "input":   { "height": 48, "bg": "surface", "border": "borderStrong", "font": "mono 13" },
    "micBtn":  { "size": 48, "idle": "border accent, icon accent", "listening": "bg accent, icon accentOn" },
    "primary": { "height": 44, "confirm": "bg warning, text warningOn" }
  },
  "background": {
    "pattern": "hex (implicit) | grid | dots | none",
    "hex": "pointy hex, latură 12px: tile 20.78x36, path 'M10.39 0L20.78 6V18L10.39 24L0 18V6Z M10.39 24V36', stroke accent 0.8px",
    "opacity": "strength/100 * 0.32 (implicit strength 45 → ~0.14)",
    "mask": "radial 50% 45%, alb 100% în centru → 25% la margini",
    "glow": "radial-gradient(ellipse 60% 55% at 50% 45%, rgba(79,216,255,0.07), transparent 70%)"
  },
  "orb": {
    "viewBox": "0 0 400 400, max 380px lățime",
    "layers": [
      "outer: r186, stroke 1, dash '2 7'",
      "static: r164, stroke border",
      "mid: r146, stroke 2, dash '90 40 10 40' (procesare: '60 860')",
      "inner: r122, stroke 6, dash '2 10', opacity .5",
      "core: radial bfF3ff→accent→transparent, r variabil",
      "center: r38, orbCenter"
    ],
    "states": {
      "idle":       { "outer": "spin 40s", "mid": "spin-rev 24s", "inner": "spin 40s", "core": "breathe 4s, r86" },
      "listening":  { "outer": "spin 5s",  "mid": "spin-rev 3s",  "inner": "spin 5s",  "core": "scale 1→1.1 la 0.7s, r100 (ideal: legat de volumul microfonului)" },
      "processing": { "outer": "spin 40s", "mid": "spin-rev 1.1s, dash '60 860'", "inner": "stop", "core": "static, r70" },
      "responding": { "outer": "spin 40s", "mid": "spin-rev 24s", "inner": "spin 5s",  "core": "pulse 1s, r96 (ideal: legat de amplitudinea audio TTS)" },
      "confirm":    { "rings": "oprite, culoare warning" },
      "offline":    { "rings": "oprite, culoare offline, dash '4 14'", "core": "gri" }
    },
    "pipelineEvents": { "listening": "stt-start → stt-end", "processing": "intent-start → intent-end", "responding": "tts-start → run-end" }
  },
  "motion": { "reducedMotion": "toate animațiile oprite la prefers-reduced-motion", "toggle": "200ms ease" }
}
